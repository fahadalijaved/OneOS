#!/sbin/sh
OUTFD=$2
ZIPFILE=$3
ui_print() {
  echo "ui_print $1" >&$OUTFD
  echo "ui_print" >&$OUTFD
}

# Extraction & standard Magisk / KernelSU loader
MODPATH="/data/adb/modules/oneos_helper"
mkdir -p "$MODPATH"
unzip -o "$ZIPFILE" -d "$MODPATH" >/dev/null

if [ -f "$MODPATH/customize.sh" ]; then
  . "$MODPATH/customize.sh"
fi

exit 0

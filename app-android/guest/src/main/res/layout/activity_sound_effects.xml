<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/preboot_page">

    <dev.oneuiproject.oneui.layout.ToolbarLayout
        android:id="@+id/sound_toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:expandable="false"
        app:expanded="false"
        app:handleInsets="false"
        app:mainRoundedCorners="top"
        app:showNavButtonAsBack="true">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sound_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/sound_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="24dp" />
        </androidx.core.widget.NestedScrollView>
    </dev.oneuiproject.oneui.layout.ToolbarLayout>
</FrameLayout>

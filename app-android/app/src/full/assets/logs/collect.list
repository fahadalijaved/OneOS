# OneOS 0.3.0: the last session's logs, read as root after the return to One UI
# (Last session, Collect logs). docs/app/compat-safety-logs.md sections 3.1, 3.3.
#
# The same runner (assets/probe/probe.sh) and grammar as the probe list, and
# the same read-only audit (ProbeAudit): every command only reads, root writes
# no file. The output goes to OneOS over a pipe and is redacted line by line
# before it is written to the app's cache (logcat lines of personal tags are
# dropped, personal values masked). Text files only: never the screen
# recordings (oneos_rec_*.mp4) or screenshots (shot_*.png, fold_*.png).
#
# The first two entries are kept in memory only, never saved or shared: they
# tell the redaction which Wi-Fi network names and Bluetooth device names to
# remove from everything after them.
#
# The stage is /data/local/tmp/oneos; while nothing is there and its path up
# to 0.3.6 (/data/local/tmp/lineage_stage) is a folder, the entries read that
# one (a session of 0.3.6, not prepared again since).

#== Names to remove

#: Saved Wi-Fi network and hotspot names of One UI and of the guest (the name
#: elements only; no passwords are read). Kept in memory to remove them from the logs.
run logs.ssids 20 memory/ssids.txt '
S=/data/local/tmp/oneos
[ -e "$S" ] || [ -L "$S" ] || [ ! -d /data/local/tmp/lineage_stage ] || [ -L /data/local/tmp/lineage_stage ] || S=/data/local/tmp/lineage_stage
for f in /data/misc/apexdata/com.android.wifi/WifiConfigStore.xml /data/misc/apexdata/com.android.wifi/WifiConfigStoreSoftAp.xml /data/misc/wifi/WifiConfigStore.xml /data/misc/wifi/softap.conf "$S/data/misc/apexdata/com.android.wifi/WifiConfigStore.xml" "$S/data/misc/apexdata/com.android.wifi/WifiConfigStoreSoftAp.xml"; do
  [ -f "$f" ] && grep -h -o -i -E "name=\"[a-z]*ssid\".[^<]*" "$f"
done
for d in /data/misc_ce/*/apexdata/com.android.wifi; do
  [ -f "$d/WifiConfigStore.xml" ] && grep -h -o -i -E "name=\"[a-z]*ssid\".[^<]*" "$d/WifiConfigStore.xml"
done
true'

#: Input devices as the kernel lists them. Kept in memory to remove Bluetooth device names from the logs.
run logs.input 10 memory/input_devices.txt 'cat /proc/bus/input/devices'

#== Session

#: Why the phone last booted (the return reboots with reason oneos-return),
#: and Samsung's own record of the last reset where the phone keeps one
#: (sec_debug: reset_reason such as KPON for a kernel panic, extra, auto_comment).
run logs.reason 10 boot/reason.txt '
printf "sys.boot.reason=%s\n" "$(getprop sys.boot.reason)"
printf "persist.sys.boot.reason.history=%s\n" "$(getprop persist.sys.boot.reason.history)"
printf "sys.reset_reason=%s\n" "$(getprop sys.reset_reason)"
for f in /proc/reset_reason /proc/extra /proc/auto_comment; do
  [ -r "$f" ] && printf "%s: %s\n" "$f" "$(head -c 2000 "$f" | tr -d "\000")"
done
true'

#: The end of the kernel log of the boot before this one (Samsung's last_kmsg):
#: what the kernel printed before a hard reset that left no return log (Galaxy
#: S26+ 80387c66, Galaxy S23 699602d7).
run logs.lastkmsg 20 boot/last_kmsg.txt '
[ -r /proc/last_kmsg ] || exit 3
tail -n 3000 /proc/last_kmsg | tr -d "\000"'

#: The session record the app's launch wrote (session/current.json).
run logs.current 10 stage/current.json '
S=/data/local/tmp/oneos
[ -e "$S" ] || [ -L "$S" ] || [ ! -d /data/local/tmp/lineage_stage ] || [ -L /data/local/tmp/lineage_stage ] || S=/data/local/tmp/lineage_stage
f="$S/session/current.json"
[ -f "$f" ] || exit 3
cat "$f"'

#: The switch, return and watcher logs in the stage (takeover_app.log, auto_return.log, ...).
files logs.stage 120 stage '
S=/data/local/tmp/oneos
[ -e "$S" ] || [ -L "$S" ] || [ ! -d /data/local/tmp/lineage_stage ] || [ -L /data/local/tmp/lineage_stage ] || S=/data/local/tmp/lineage_stage
for f in "$S"/*.log; do [ -f "$f" ] && printf "%s\n" "$f"; done
true'

#: The guest's logs in its /data (takeover.log, call_audio.log, audio_keeper.log, backlight.log, ...),
#: and (0.4.30) the guest OneOS app's checklist, How's it going?, for Send to the OneOS team.
files logs.guest 120 guest '
S=/data/local/tmp/oneos
[ -e "$S" ] || [ -L "$S" ] || [ ! -d /data/local/tmp/lineage_stage ] || [ -L /data/local/tmp/lineage_stage ] || S=/data/local/tmp/lineage_stage
for f in "$S"/data/*.log; do [ -f "$f" ] && printf "%s\n" "$f"; done
c="$S/data/user/0/com.fahadali.oneos.guest/files/oneos_checklist.json"
[ -f "$c" ] && [ ! -L "$c" ] && printf "%s\n" "$c"
true'

#: Host helper logs (UI activator, adb and IMS watchdogs).
files logs.host 60 host '
for f in /data/local/tmp/ui_activator.log /data/local/tmp/adb_watchdog.log /data/local/tmp/ims_watchdog.log /data/local/tmp/restore_app.log; do
  [ -f "$f" ] && printf "%s\n" "$f"
done
true'

#: Diagnostics rounds of the session and its 30 s sampler (diag_series.txt): text files only (.txt, .log, .xml, .err), no screenshots.
files logs.diag 120 diag '
S=/data/local/tmp/oneos
[ -e "$S" ] || [ -L "$S" ] || [ ! -d /data/local/tmp/lineage_stage ] || [ -L /data/local/tmp/lineage_stage ] || S=/data/local/tmp/lineage_stage
[ -f "$S/diag_series.txt" ] && printf "%s\n" "$S/diag_series.txt"
for f in "$S"/diag_*/*; do
  [ -f "$f" ] || continue
  for e in .txt .log .xml .err; do
    [ "${f%$e}" != "$f" ] && printf "%s\n" "$f"
  done
done
true'

#: The session's full log capture (oneos_logs/boot.log*, all buffers, 32 MB each), after the files of the boot that only head/ still has.
files logs.capture 300 capture '
L=/data/local/tmp/oneos_logs
T=" "
for f in "$L"/boot.log*; do
  [ -f "$f" ] || continue
  i=$(stat -c %i "$f")
  [ -n "$i" ] && T="$T$i "
done
for f in "$L"/head/boot.log*; do
  [ -f "$f" ] || continue
  i=$(stat -c %i "$f")
  [ -n "$i" ] && printf "%s\n" "$T" | grep -q " $i " && continue
  printf "%s\n" "$f"
done
for f in "$L"/boot.log*; do [ -f "$f" ] && printf "%s\n" "$f"; done
true'

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark values of the redesign tokens (values/colors.xml). The brand
         colours oneos_blue and oneos_purple are the same in both modes. -->

    <!-- White text 4.7:1; 3.8:1 against the dark card. -->
    <color name="oneos_primary">#2F6FE0</color>
    <!-- 5.5:1 or more on #010101, #171717, the dialog #252525 and the dark tile. -->
    <color name="oneos_primary_text">#6E9BFF</color>
    <color name="oneos_purple_text">#A592F5</color>

    <color name="oneos_text_secondary">#A6A6A6</color>
    <color name="oneos_icon">#D0D0D0</color>

    <color name="oneos_tile_bg">#23272F</color>
    <color name="oneos_tile_bg_warn">#33261E</color>
    <color name="oneos_tile_bg_block">#382222</color>

    <color name="oneos_info">#A6A6A6</color>
    <color name="oneos_on_status">#010101</color>

    <!-- The dark functional colours already reach 5.3:1 or more. -->
    <color name="oneos_ok_text">@color/oui_des_functional_green_color</color>
    <color name="oneos_warn_text">@color/oui_des_functional_orange_color</color>
    <color name="oneos_block_text">@color/oui_des_functional_red_color</color>

    <color name="oneos_button_secondary_bg">#333333</color>
</resources>

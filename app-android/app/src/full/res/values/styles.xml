<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Redesign styles (docs/app/redesign-2.md). Every style names its parent
         (or parent=""), so no dotted name needs an implicit "OneOS" parent. -->

    <!-- Surfaces ============================================================ -->

    <!-- One UI card: ?android:colorBackground, 26dp corners (a shape, not
         MaterialCardView, which crashes under OneUITheme). Clips its children
         to the corners, so row ripples stay inside. Put it on the window colour. -->
    <style name="OneOS.Card" parent="">
        <item name="android:background">@drawable/oneos_card_bg</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/oneos_card_padding</item>
        <item name="android:paddingEnd">@dimen/oneos_card_padding</item>
        <item name="android:paddingTop">@dimen/oneos_card_padding</item>
        <item name="android:paddingBottom">@dimen/oneos_card_padding_bottom</item>
    </style>

    <!-- A card that holds oneos_row items: no side padding, 6dp top and bottom. -->
    <style name="OneOS.Card.List" parent="OneOS.Card">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">@dimen/oneos_card_list_padding</item>
        <item name="android:paddingBottom">@dimen/oneos_card_list_padding</item>
    </style>

    <!-- Check tile inside a card: 16dp corners on @color/oneos_tile_bg. -->
    <style name="OneOS.Tile" parent="">
        <item name="android:background">@drawable/oneos_tile_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/oneos_tile_padding</item>
    </style>

    <!-- A whole-row tap target in a list card: 56dp or more. -->
    <style name="OneOS.Row" parent="">
        <item name="android:background">@drawable/oneos_row_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/oneos_row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/oneos_row_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/oneos_row_padding_horizontal</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Buttons ============================================================= -->

    <!-- The one main action: a 52dp pill in ?attr/colorPrimary, white bold 17sp. -->
    <style name="OneOS.Button.Primary" parent="Widget.AppCompat.Button.Colored" />
    <style name="OneOS.Button.Secondary" parent="Widget.AppCompat.Button" />

    <!-- A minor action: bold primary-blue text, rounded ripple, 48dp tall. -->
    <style name="OneOS.Button.Text" parent="OneUI.ButtonStyleTransparent">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/oneos_button_text_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Text (only textAppearance attributes, so each works as style= or as
         android:textAppearance) ============================================= -->

    <!-- The system name under the hero picture. -->
    <style name="OneOS.Text.Hero" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">32sp</item>
    </style>

    <!-- The inner screen's larger hero (HomeInner). -->
    <style name="OneOS.Text.Hero.Large" parent="OneOS.Text.Hero">
        <item name="android:textSize">36sp</item>
    </style>

    <!-- Small blue label above the hero ("OneOS"). -->
    <style name="OneOS.Text.Overline" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/oneos_primary_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Card headers ("Your phone is ready"). -->
    <style name="OneOS.Text.Title" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A check tile's name ("Root"). -->
    <style name="OneOS.Text.Title.Tile" parent="OneOS.Text.Title">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- The line under the hero ("Ready to switch"). -->
    <style name="OneOS.Text.Subtitle" parent="">
        <item name="android:textColor">@color/oneos_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Row titles and running text. -->
    <style name="OneOS.Text.Body" parent="">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Row summaries, tile values, the note under the main button. -->
    <style name="OneOS.Text.Caption" parent="">
        <item name="android:textColor">@color/oneos_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- A card header's trailing status ("4 of 4 checks"); Cards sets the level colour. -->
    <style name="OneOS.Text.Caption.Strong" parent="OneOS.Text.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/setup_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/setup_column" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingBottom="16dp">
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/setup_title" style="@style/OneOS.Setup.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="20dp" android:accessibilityHeading="true" android:accessibilityLiveRegion="polite" />
        <include layout="@layout/setup_artwork" android:layout_width="match_parent" android:layout_height="356dp" />
        <dev.oneuiproject.oneui.widget.RoundedLinearLayout android:id="@+id/setup_steps" style="@style/OneOS.Card.List" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingVertical="0dp" />
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/setup_subtitle" style="@style/OneOS.Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:visibility="gone" />
        <LinearLayout android:id="@+id/setup_details_slot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

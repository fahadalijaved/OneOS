<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_backdrop"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/onboarding_gradient_bg">
    <View android:id="@+id/onboarding_settle_overlay" android:layout_width="match_parent"
        android:layout_height="match_parent" android:alpha="0" android:background="@drawable/onboarding_settle_overlay" />
    <LinearLayout android:id="@+id/onboarding_root" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal">
        <ScrollView android:id="@+id/onboarding_card_scroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
            android:background="@android:color/transparent">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:minHeight="520dp" android:paddingHorizontal="24dp" android:paddingTop="12dp" android:paddingBottom="24dp">
                <LinearLayout android:id="@+id/onboarding_body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <ImageView android:id="@+id/onboarding_icon" android:layout_width="112dp" android:layout_height="112dp" android:layout_marginBottom="24dp"
                        android:importantForAccessibility="no" android:src="@drawable/onboarding_icon" />
                    <com.fahadali.oneos.ui.AnimatedTitleView android:id="@+id/onboarding_title"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sec" android:includeFontPadding="false" android:gravity="center"
                        android:textColor="?android:textColorPrimary" android:textSize="32sp"
                        android:textStyle="bold" android:accessibilityHeading="true" />
                    <LinearLayout android:id="@+id/onboarding_rows" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="52dp" android:orientation="vertical" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/onboarding_next"
            style="@style/OneOS.WrappingButton" android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme"
            android:fontFamily="sec" android:includeFontPadding="false" android:layout_width="268dp"
            android:layout_height="wrap_content" android:minHeight="58dp" android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

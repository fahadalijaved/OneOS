<?xml version="1.0" encoding="utf-8"?>
<!-- One step of iOS 27's checklist (OneiosSteps, OneiosStepRow): its state icon (done, to do, running with its ring,
     failed), its name and one line; while it runs the phase in words, a real bar and the amount with Cancel where
     cancelling is safe; when it failed the reason in one line and Show log. TalkBack reads the row as one item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/oneos_row_ripple"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/oneios_step_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/oneios_step_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/OneOS.Text.Body"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/oneios_step_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/preboot_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/oneios_step_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/oneios_step_running"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/oneios_step_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/OneOS.Text.Body"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SeslProgressBar
            android:id="@+id/oneios_step_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressTint="@color/preboot_primary"
            android:indeterminateTint="@color/preboot_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/oneios_step_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/preboot_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/oneios_step_cancel"
                style="@style/OneUI.ButtonStyleTransparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/oneios_step_cancel"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/oneios_step_failed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/oneios_step_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/oneios_check_fail"
            android:textSize="14sp" />

        <Button
            android:id="@+id/oneios_step_log"
            style="@style/OneUI.ButtonStyleTransparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/oneios_step_show_log"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>

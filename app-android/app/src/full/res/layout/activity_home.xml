<?xml version="1.0" encoding="utf-8"?>
<!-- Home on the cover screen (Main.dc.html): a plain bar with the menu (the
     hero below names the app), the scrolling column of StatusHomeFragment
     (home_content), and the pinned footer: the one main button, the line
     under it, and a text button when there is one (Done, Details). The inner
     screen's two panes are in layout-w600dp-h480dp. -->
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:handleInsets="false"
    app:mainRoundedCorners="top"
    app:expandable="false"
    app:expanded="false">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/home_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/oneos_screen_gutter"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/oneos_screen_gutter"
        android:paddingBottom="16dp"
        app:layout_location="footer">

        <Button
            android:id="@+id/home_primary"
            style="@style/OneOS.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_choose" />

        <TextView
            android:id="@+id/home_caption"
            style="@style/OneOS.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:visibility="gone" />

        <Button
            android:id="@+id/home_secondary"
            style="@style/OneOS.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

    </LinearLayout>

</dev.oneuiproject.oneui.layout.ToolbarLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Home's hero (Main.dc.html, top): the two-system picture (or Welcome
     back's badge), "OneOS", the system name or the state in big light type,
     and one line with a small loader while Home checks or works. Bound by
     StatusHomeFragment. The inner screen's is in layout-w600dp-h480dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <com.fahadali.oneos.ui.OsArtworkView
        android:id="@+id/home_hero_art" android:layout_width="match_parent" android:layout_height="320dp"
        android:background="@drawable/catalog_card_bg" android:foreground="@drawable/catalog_card_outline" android:clipToOutline="true" />

    <ImageView
        android:id="@+id/home_hero_badge"
        android:layout_width="@dimen/home_badge_size"
        android:layout_height="@dimen/home_badge_size"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/home_welcome_ok"
        android:visibility="gone" />

    <TextView
        android:id="@+id/home_hero_overline"
        style="@style/OneOS.Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/home_overline" />

    <TextView
        android:id="@+id/home_hero_title"
        style="@style/OneOS.Text.Hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityHeading="true"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SeslProgressBar
            android:id="@+id/home_hero_loader"
            style="@style/Widget.AppCompat.ProgressBar.Small.Title"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_hero_line"
            style="@style/OneOS.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center" />

    </LinearLayout>

    <TextView
        android:id="@+id/home_hero_extra"
        style="@style/OneOS.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>

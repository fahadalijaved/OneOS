<?xml version="1.0" encoding="utf-8"?>
<!-- Home on the inner screen (HomeInner.dc.html): the bar names the app and
     holds the menu; StatusHomeFragment's two panes (home_content) carry the
     main button inside the hero card, so there is no footer here. -->
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:handleInsets="false"
    app:mainRoundedCorners="top"
    app:expandable="false"
    app:expanded="false">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</dev.oneuiproject.oneui.layout.ToolbarLayout>

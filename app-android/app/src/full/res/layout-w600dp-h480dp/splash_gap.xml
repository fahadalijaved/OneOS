<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/splash_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="#010102" android:padding="24dp">

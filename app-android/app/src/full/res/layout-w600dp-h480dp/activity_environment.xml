<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/environment_window" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/oneos_page_background">
<androidx.appcompat.widget.Toolbar android:id="@+id/environment_toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/oneos_page_background" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingHorizontal="32dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:baselineAligned="false">
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"><include layout="@layout/environment_artwork" /></FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="32dp" android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/environment_title" style="@style/OneOS.Setup.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="40dp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.core.widget.NestedScrollView android:id="@+id/environment_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false"><LinearLayout android:id="@+id/environment_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></androidx.core.widget.NestedScrollView>
            <include layout="@layout/environment_action" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

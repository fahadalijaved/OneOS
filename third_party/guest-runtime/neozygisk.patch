new file mode 100644
index 0000000..5ea5efe
--- /dev/null
+++ b/loader/src/ptracer/guest_target.hpp
@@ -0,0 +1,33 @@
+#pragma once
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <cstdio>
+#include <string>
+
+// OneOS launches the tracer and the stopped zygote as siblings. The target
+// must remain a child of the invoking launcher, in this guest filesystem root.
+// caller == 1 is refused: orphan adoption must never authorize init's services.
+inline bool guest_trace_target_is_child(pid_t target, pid_t caller,
+                                       const char *proc_root = "/proc",
+                                       const char *guest_root = "/") {
+    if (target <= 1 || caller <= 1 || target == getpid()) return false;
+    const std::string path = std::string(proc_root) + "/" + std::to_string(target);
+    const int process = open(path.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (process < 0) return false;
+    struct stat actual{}, expected{};
+    const bool same_root = fstatat(process, "root", &actual, 0) == 0 &&
+                           stat(guest_root, &expected) == 0 &&
+                           actual.st_dev == expected.st_dev && actual.st_ino == expected.st_ino;
+    const int status_fd = same_root ? openat(process, "status", O_RDONLY | O_CLOEXEC | O_NOFOLLOW) : -1;
+    close(process);
+    if (status_fd < 0) return false;
+    FILE *status = fdopen(status_fd, "r");
+    if (!status) { close(status_fd); return false; }
+    char line[512];long parent = -1;
+    while (fgets(line, sizeof(line), status)) {
+        if (sscanf(line, "PPid:%ld", &parent) == 1) break;
+    }
+    fclose(status);
+    return parent == caller;
+}

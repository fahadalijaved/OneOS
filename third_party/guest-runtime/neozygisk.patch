diff --git a/zygiskd/src/guest_policy.rs b/zygiskd/src/guest_policy.rs
new file mode 100644
index 0000000..f0b871a
--- /dev/null
+++ b/zygiskd/src/guest_policy.rs
@@ -0,0 +1,110 @@
+//! Guest identity checks shared by daemon entry points and regression tests.
+use anyhow::{Context, Result, bail};
+use std::fs::{self, File};
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::os::unix::fs::MetadataExt;
+use std::path::Path;
+
+fn open_at(directory: &File, name: &std::ffi::CStr, flags: i32) -> Result<File> {
+    // The proc directory FD pins this process lookup; a reused numeric PID
+    // cannot redirect later root/namespace opens to a different process.
+    let fd = unsafe { libc::openat(directory.as_raw_fd(), name.as_ptr(), flags | libc::O_CLOEXEC) };
+    if fd < 0 { return Err(std::io::Error::last_os_error().into()); }
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+fn namespace_from_process(process: &File, guest_root: &Path) -> Result<File> {
+    let root = open_at(process, c"root", libc::O_RDONLY | libc::O_DIRECTORY)?;
+    let actual = root.metadata()?;
+    let expected = fs::metadata(guest_root)?;
+    if actual.dev() != expected.dev() || actual.ino() != expected.ino() {
+        bail!("daemon peer does not belong to this guest filesystem root");
+    }
+    open_at(process, c"ns/mnt", libc::O_RDONLY)
+}
+
+/// `peer_pid` must come from SO_PEERCRED, never the request payload.
+pub fn peer_mount_namespace(peer_pid: i32) -> Result<File> {
+    let process = File::open(format!("/proc/{peer_pid}"))
+        .context("cannot open daemon peer process")?;
+    namespace_from_process(&process, Path::new("/"))
+}
+
+pub fn grant_matches(uid: i32, grants: &str, packages: &str) -> bool {
+    if uid < 10_000 { return false; }
+    grants.lines().any(|line| {
+        let mut fields = line.split_whitespace();
+        let (Some(package), Some(granted_uid)) = (fields.next(), fields.next()) else { return false; };
+        if fields.next().is_some() || package.len() > 255 || package.is_empty()
+            || !package.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'.')
+            || granted_uid.parse::<i32>().ok() != Some(uid) { return false; }
+        // A grant expires when its package disappears or receives a new UID.
+        // An unrelated app reusing the old UID must not inherit it.
+        packages.lines().find_map(|entry| {
+            let mut values = entry.split_whitespace();
+            if values.next() != Some(package) { return None; }
+            Some(values.next().and_then(|v| v.parse::<i32>().ok()) == Some(uid))
+        }).unwrap_or(false)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::symlink;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    struct Fixture(std::path::PathBuf);
+    impl Fixture {
+        fn new() -> Self {
+            let path = std::env::temp_dir().join(format!("oneos-policy-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+            fs::create_dir(&path).unwrap(); Self(path)
+        }
+        fn process(&self, name: &str, root: &Path, marker: &[u8]) -> File {
+            let path = self.0.join(name);fs::create_dir_all(path.join("ns")).unwrap();
+            symlink(root,path.join("root")).unwrap();fs::write(path.join("ns/mnt"),marker).unwrap();
+            File::open(path).unwrap()
+        }
+    }
+    impl Drop for Fixture { fn drop(&mut self) { let _ = fs::remove_dir_all(&self.0); } }
+    #[test] fn valid_current_package_is_granted() {
+        assert!(grant_matches(10042,"com.app 10042\n","com.app 10042 other columns\n"));
+    }
+    #[test] fn reused_uid_does_not_inherit_deleted_packages_grant() {
+        assert!(!grant_matches(10042,"com.old 10042\n","com.new 10042 x\n"));
+    }
+    #[test] fn changed_package_uid_invalidates_old_grant() {
+        assert!(!grant_matches(10042,"com.app 10042\n","com.app 10043 x\n"));
+    }
+    #[test] fn shared_uid_needs_one_current_matching_package() {
+        assert!(grant_matches(10042,"com.a 10042\n","com.a 10042 x\ncom.b 10042 x\n"));
+    }
+    #[test] fn malformed_grants_and_system_uids_are_denied() {
+        for grant in ["com.app nope", "com.app 10042 extra", "../app 10042", "com.app 4294977338"] {
+            assert!(!grant_matches(10042,grant,"com.app 10042 x\n"));
+        }
+        assert!(!grant_matches(1000,"com.app 1000","com.app 1000 x"));
+    }
+    #[test] fn same_guest_peer_namespace_is_pinned() {
+        let f=Fixture::new();let root=f.0.join("guest");fs::create_dir(&root).unwrap();
+        let peer=f.process("peer",&root,b"guest namespace");
+        let namespace=namespace_from_process(&peer,&root).unwrap();
+        use std::io::Read;let mut text=String::new();(&namespace).read_to_string(&mut text).unwrap();
+        assert_eq!(text,"guest namespace");
+    }
+    #[test] fn host_peer_root_is_rejected() {
+        let f=Fixture::new();let guest=f.0.join("guest");let host=f.0.join("host");
+        fs::create_dir(&guest).unwrap();fs::create_dir(&host).unwrap();
+        let peer=f.process("peer",&host,b"host namespace");
+        assert!(namespace_from_process(&peer,&guest).is_err());
+    }
+    #[test] fn process_directory_fd_prevents_pid_path_replacement() {
+        let f=Fixture::new();let guest=f.0.join("guest");let host=f.0.join("host");
+        fs::create_dir(&guest).unwrap();fs::create_dir(&host).unwrap();
+        let peer=f.process("123",&guest,b"original");
+        fs::rename(f.0.join("123"),f.0.join("old")).unwrap();
+        let _replacement=f.process("123",&host,b"replacement");
+        use std::io::Read;let mut text=String::new();namespace_from_process(&peer,&guest).unwrap().read_to_string(&mut text).unwrap();
+        assert_eq!(text,"original");
+    }
+}

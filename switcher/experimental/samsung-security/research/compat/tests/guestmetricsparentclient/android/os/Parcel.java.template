 public final void writeInterfaceToken(String s){writeString(s);}
 public void writeString(String s){if(s==null){writeInt(-1);return;}writeInt(s.length());for(int i=0;i<s.length();i++){buf().putChar(pos,s.charAt(i));pos+=2;}buf().putChar(pos,(char)0);pos+=2;while((pos&3)!=0)bytes[pos++]=0;size=Math.max(size,pos);}
 public final String readString(){plan.strings++;int n=readInt();if(n==-1)return plan.stringWrong?"wrong":null;if(n<0||n>(size-pos)/2-1)throw new BadParcelableException("model string");char[] s=new char[n];for(int i=0;i<n;i++)s[i]=buf().getChar(pos+i*2);pos+=(2*(n+1)+3)&~3;return plan.stringWrong?null:new String(s);}

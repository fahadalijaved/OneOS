 }
 public static final ThreadLocal<Plan> PLAN=new ThreadLocal<Plan>();
 public final Plan plan; public final boolean reply; public byte[] bytes=new byte[131072]; public int pos,size;
 public final List<Integer> binderObjects=new ArrayList<Integer>(),fdObjects=new ArrayList<Integer>();

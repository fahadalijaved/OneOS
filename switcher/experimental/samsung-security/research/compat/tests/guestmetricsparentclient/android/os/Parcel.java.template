 public static Parcel obtain(IBinder b){Parcel p=acquire();p.plan.owner=b;return p;}
 public static Parcel obtain(){return acquire();}
 private static Parcel acquire(){Plan p=PLAN.get();int n=++p.obtains;Throwable t=n==1?p.obtain1:p.obtain2;if(t!=null)throw unchecked(t);Parcel v=new Parcel(p,n==2);if(n==1)p.request=v;else p.reply=v;return v;}
 public int dataSize(){return reply&&plan.reported>=0?plan.reported:!reply&&plan.requestSize>=0?plan.requestSize:size;}
 public final int dataAvail(){return size-pos;}

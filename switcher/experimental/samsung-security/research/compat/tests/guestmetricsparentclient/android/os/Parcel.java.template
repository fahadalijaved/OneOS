package android.os;
import java.nio.*;
import java.util.*;
/** Entirely authored byte-buffer API model. No Android decoder/serialization/native implementation. */
public final class Parcel {
 public static final class Plan {
  public int obtains,recycles,decodes,ranges,strings; public Throwable obtain1,obtain2,requestClose,replyClose,decoder;

 public void patch(int at,int v){buf().putInt(at,v);}
 public byte[] snapshot(){return Arrays.copyOf(bytes,size);}
 public static RuntimeException unchecked(Throwable t){Parcel.<RuntimeException>raise(t);return null;}
 @SuppressWarnings("unchecked")private static <T extends Throwable>void raise(Throwable t)throws T{throw(T)t;}
}

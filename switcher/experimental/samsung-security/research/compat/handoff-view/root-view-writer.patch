+++ b/firmware/oneos-pr/OneOS/app-android/app/src/full/assets/root/oneos_root.sh
@@ -1619,6 +1619,44 @@
     say "@@OK closed-controller-installed"
 )
 
+# Fixed cooperative lease. Neither a file's contents nor an inherited FD's
+# name grants readiness: actual exclusive flock and object checks are required.
+RWW=/dev/oneos-retained-view
+rww_profile() {
+    [ ! -L /dev ] && [ -d /dev ] && [ "$(stat -c %u /dev)" = 0 ] || return 1
+    case "$(stat -c %a /dev)" in [57][0145][0145]) ;; *) return 1;; esac
+    [ ! -L "$RWW" ] && [ -d "$RWW" ] && [ "$(stat -c '%u:%g:%a' "$RWW")" = 0:0:700 ] || return 1
+    [ ! -L "$RWW/lease" ] && [ -f "$RWW/lease" ] &&
+        [ "$(stat -c '%u:%g:%a:%h:%s' "$RWW/lease")" = 0:0:600:1:0 ]
+}
+rww_no_view() {
+    [ ! -e "$RWW/view-blocked" ] && [ ! -L "$RWW/view-blocked" ]
+}
+rww_legacy() {
+    case "$1" in
+        launch|recover)
+            if [ ! -e "$RWW/legacy-blocked" ] && [ ! -L "$RWW/legacy-blocked" ]; then
+                mkdir -m 0700 "$RWW/legacy-blocked" || return 1
+            fi
+            [ ! -L "$RWW/legacy-blocked" ] && [ -d "$RWW/legacy-blocked" ] &&
+                [ "$(stat -c '%u:%g:%a' "$RWW/legacy-blocked")" = 0:0:700 ] || return 1
+            ;;
+    esac
+}
+rww_refuse() { echo "@@REFUSED cooperative view/writer lease unavailable"; exit 2; }
+[ "$(id -u)" = 0 ] && rww_profile && [ -x /system/bin/flock ] || rww_refuse
+# Only the selected outer RootScript supplies its already-owned description.
+# Direct old launchers have no admitted lease issuer and refuse here.
+[ -e /proc/self/fd/3 ] || rww_refuse
+[ "$(stat -Lc '%d:%i:%f:%u:%g:%s:%h' /proc/self/fd/3 3<&3)" = "$(stat -c '%d:%i:%f:%u:%g:%s:%h' "$RWW/lease")" ] || rww_refuse
+/system/bin/flock -xn 3 3<&3 || rww_refuse
+rww_profile && rww_no_view || rww_refuse
+# Only the real outer creator may retire its exact marker after child return
+# and local cleanup. No argv/environment flag or direct rootsh reset exists.
+[ ! -L "$RWW/writer-blocked" ] && [ -d "$RWW/writer-blocked" ] &&
+    [ "$(stat -c '%u:%g:%a' "$RWW/writer-blocked")" = 0:0:700 ] || rww_refuse
+rww_legacy "$1" || rww_refuse
+
 # --- Main ---------------------------------------------------------------------
 [ -n "$T" ] || [ "$(id -u)" = 0 ] || refuse "not root"
 verb=$1

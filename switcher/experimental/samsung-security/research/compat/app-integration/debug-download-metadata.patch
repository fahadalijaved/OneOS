+        check(metadata.last() == 10.toByte()) { "metadata requires final LF" }
+        val rows = metadata.toString(Charsets.US_ASCII).split('\n').dropLast(1)
+        check(rows.size == 242) { "metadata requires 242 rows" }
+        val sizes = linkedMapOf<String, Long>()
+        for (row in rows) {
+            val m = Regex("^([0-9a-f]{64})\t([1-9][0-9]{0,8})$").matchEntire(row)
+                ?: throw GradleException("invalid debug asset metadata row")
+            val size = m.groupValues[2].toLongOrNull() ?: throw GradleException("invalid debug asset size")
+            check(size in 1L..receiveMax) { "debug asset exceeds root receive bound" }
+            check(sizes.put(m.groupValues[1], size) == null) { "duplicate debug asset hash" }
+        }
+        check(sizes.keys == required) { "missing or extraneous debug asset hashes" }
+        return DebugDownloads(sizes, lists)
+    }

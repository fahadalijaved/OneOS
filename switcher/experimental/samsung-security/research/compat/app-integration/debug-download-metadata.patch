+        )
+        check(sets.get().keys == packagePins.keys) { "debug metadata requires all nine original sets" }
+        val directory = packages.get().asFile
+        val lists = linkedMapOf<String, Map<String, String>>()
+        for ((id, expected) in packagePins) {
+            val bytes = debugBytes(File(directory, "$id.sha256"), expected, 65_536)
+            val want = linkedMapOf<String, String>()
+            bytes.toString(Charsets.UTF_8).lineSequence().filter { it.isNotBlank() && !it.startsWith("#") }.forEach { line ->
+                val m = Regex("^([0-9a-f]{64})  ([A-Za-z0-9_][A-Za-z0-9._+-]*)$").matchEntire(line)
+                    ?: throw GradleException("$id: invalid pinned set list")
+                check(want.put(m.groupValues[2], m.groupValues[1]) == null) { "$id: duplicate pinned filename" }
+            }
+            check(want.isNotEmpty()) { "$id: empty pinned set" }
+            lists[id] = want

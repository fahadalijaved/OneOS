+        val required = lists.values.flatMap { it.values }.toSet()
+        check(required.size == 242) { "expected 242 genuine current hashes" }
+        val remoteBytes = debugBytes(File(directory, "remote.txt"), "0dc3487438439386da64635d3ab9a4d014a3d60583aa9f1163e0e37e556972a0", 131_072)
+        val pinnedRemote = linkedMapOf<String, String>()
+        remoteBytes.toString(Charsets.UTF_8).lineSequence().map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }.forEach { line ->
+            val m = Regex("^([0-9a-f]{64}) (.+)$").matchEntire(line) ?: throw GradleException("invalid pinned remote mapping")

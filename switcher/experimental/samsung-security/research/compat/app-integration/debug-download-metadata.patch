+    // Read one opened snapshot only, with a final-component nofollow open and
+    // bounded length/EOF. The fixed hash checks the selected build-input profile;
+    // it is not proof that any remote payload was downloaded or verified.
+    private fun debugBytes(f: File, expected: String, limit: Int): ByteArray {
+        val path = f.toPath()
+        val nofollow = java.nio.file.LinkOption.NOFOLLOW_LINKS
+        val before = java.nio.file.Files.readAttributes(path, java.nio.file.attribute.BasicFileAttributes::class.java, nofollow)
+        check(before.isRegularFile && !java.nio.file.Files.isSymbolicLink(path)) { "debug metadata must be a regular nonlink file: $f" }
+        val data = java.nio.channels.FileChannel.open(path, java.nio.file.StandardOpenOption.READ, nofollow).use { channel ->
+            val length = channel.size()
+            check(length in 1L..limit.toLong()) { "debug metadata bound: $f" }
+            val buffer = java.nio.ByteBuffer.allocate(length.toInt())
+            while (buffer.hasRemaining()) check(channel.read(buffer) > 0) { "truncated debug metadata: $f" }
+            check(channel.read(java.nio.ByteBuffer.allocate(1)) == -1) { "growing debug metadata: $f" }
+            buffer.array()
+        }
+        val after = java.nio.file.Files.readAttributes(path, java.nio.file.attribute.BasicFileAttributes::class.java, nofollow)
+        check(after.isRegularFile && before.fileKey() != null && before.fileKey() == after.fileKey()) { "debug metadata identity changed: $f" }
+        val digest = MessageDigest.getInstance("SHA-256").digest(data).joinToString("") { "%02x".format(it) }
+        check(digest == expected) { "debug metadata source hash differs: $f" }
+        return data
+    }
